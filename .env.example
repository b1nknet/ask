# npm run setup creates .env and fills a missing or empty secret; existing values are kept.
# Start the app and open / to create the first admin in the browser when no accounts exist.
# Once an account exists, web setup closes automatically; no admin credentials belong here.
# GitHub Actions runs only for develop pushes and PRs targeting develop, using test-only values.
# GHCR publishing uses the automatic GITHUB_TOKEN with packages:write; no extra Secrets required.
# Fork and Dependabot PRs build images without publishing. No registry credentials belong here.
# Never reuse the workflow's public test secret in production.
DATABASE_URL="file:./data/ask.db"
BETTER_AUTH_SECRET=""
# App port for local dev, npm start, and Docker Compose (default: 3000).
# Compose publishes this port on the host as well.
# Update BETTER_AUTH_URL for local dev / npm start, or PUBLIC_URL for Compose.
PORT="3000"
BETTER_AUTH_URL="http://localhost:3000"

# Optional Cloudflare Turnstile: set both keys to protect question submissions.
# The site key is public; the secret key stays on the server.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Enable only when the app is reachable exclusively through a trusted proxy
# that overwrites X-Real-IP. Applies to local execution and Docker Compose.
# Valid IPs are saved with questions for admin-only display; otherwise shown as unavailable.
TRUST_PROXY="false"
NEXT_TELEMETRY_DISABLED="1"

# Docker Compose: browser-facing URL, passed to BETTER_AUTH_URL in the container.
# Configure your domain and HTTPS separately when deploying publicly.
# compose.yaml pulls ghcr.io/b1nknet/ask:latest and ghcr.io/b1nknet/ask-tools:latest.
# Docker-only setup: copy this file to .env, set BETTER_AUTH_SECRET (openssl rand -hex 32),
# and set PUBLIC_URL. Node.js and npm run setup are not required on the server.
# To build from source instead, add -f compose.yaml -f compose.build.yaml to Compose commands.
PUBLIC_URL="http://localhost:3000"
