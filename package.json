{
  "name": "ask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "prisma generate",
    "build": "next build",
    "postbuild": "tsx scripts/prepare-standalone.ts",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "setup": "tsx scripts/setup.ts && npm run db:generate && npm run db:deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/check-migrations.ts && prisma migrate deploy && tsx scripts/configure-db.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx --test tests/smoke/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.14",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "better-sqlite3": "12.11.1",
    "dotenv": "^18.0.9",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
